# ===== WhatsApp via CallMeBot (FREE - recommended for personal use) =====
# How to get the API key:
#  1. Save +34 644 51 95 23 in your phone contacts as "CallMeBot"
#  2. Send WhatsApp message: "I allow callmebot to send me messages"
#  3. You will receive an API key. Paste it below.
#  4. Phone number must include country code without '+', e.g. 919876543210
CALLMEBOT_PHONE=917300835880
CALLMEBOT_APIKEY=your_callmebot_api_key

# ===== Twilio WhatsApp (PAID - alternative, uncomment to use) =====
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_TO=whatsapp:+919876543210

# ===== Notification provider: callmebot | twilio | console =====
NOTIFIER=callmebot

# ===== Scan settings =====
MIN_PRICE=50
MAX_PRICE=5000
MIN_VOLUME=100000
TARGET_PCT_MIN=5
TARGET_PCT_MAX=15
TOP_N=10

# ===== Ultra-High Accuracy Filters =====
CHECK_NIFTY_TREND=true
MIN_RR_RATIO=2.0
MIN_TURNOVER_CR=10.0

# ===== Schedule (24h IST). Markets close 15:30, run a few minutes after =====
RUN_TIME=15:35
